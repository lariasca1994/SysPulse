# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.

# --- Telegram ---
# Token del bot (lo entrega @BotFather)
TELEGRAM_BOT_TOKEN=
# chat_id de las 2 cuentas fijas, separados por coma (ej. 123456789,987654321)
TELEGRAM_FIXED_CHAT_IDS=
# Secreto aleatorio para validar el webhook (letras, números, _ y -; 32+ caracteres)
TELEGRAM_WEBHOOK_SECRET=

# Usuario del bot (sin @), para los enlaces t.me/<bot>?start=…
TELEGRAM_BOT_USUARIO=sysplusbot

# --- Web ---
# URL de la web (enlaces de verificación de correo). Local: http://localhost:5173
WEB_URL=http://localhost:5173

# --- Brevo ---
# false = los correos solo se registran en el log (desarrollo); true = se envían de verdad (consume la cuota)
CORREO_ENVIAR=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SysPulse

# --- MongoDB Atlas ---
MONGO_URI=
# Cadena estándar para el agente Android (mongodb+srv no funciona en Android). Se genera con:
#   dotnet run --project tools/SysPulse.AgentInstaller -- mongo-estandar
MONGO_URI_ANDROID=

# --- API ---
JWT_SECRET=
MFA_ENCRYPTION_KEY=
AGENT_API_KEY=
CORS_ORIGIN=
# URL de la API que usan los agentes para los eventos (se distribuye con config-central, sin reinstalar).
# Local: http://localhost:5095 · Producción: la URL del servicio en Render
API_URL=
# Zona horaria de las horas en Telegram y correo (IANA)
ZONA_HORARIA=America/Bogota

# --- Admin semilla ---
ADMIN_EMAIL=
ADMIN_TEMP_PASSWORD=

# --- Integraciones ---
CLOUDINARY_URL=
