<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Solo Android: iOS no permite monitoreo continuo y su distribución tiene costo. -->
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>SysPulse.Agent.Android</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>SysPulse Agent</ApplicationTitle>
		<ApplicationId>dev.syspulse.agent</ApplicationId>
		<ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
		<ApplicationVersion>3</ApplicationVersion>

		<!-- Android 10 (API 29): estado térmico del sistema. Teléfono de referencia: Android 16 (API 36). -->
		<SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B2A5B" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B2A5B" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="MongoDB.Driver" Version="3.12.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SysPulse.Agent.Core\SysPulse.Agent.Core.csproj" />
	</ItemGroup>

</Project>
